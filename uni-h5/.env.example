# 复制为 .env.development.local 后按需修改（`.env.*.local` 已被 gitignore）。
#
# 【不要复制成 .env.local】Vite 在 production 构建里同样会加载 `.env.local`，
# 那会把这里的内容（尤其是 VITE_DEV_TOKEN）静态内联进生产 JS。
# 只在 dev 模式加载的 `.env.development.local` 才是正确位置。
#
# 生产构建的硬门禁：src/config/index.ts 的 assertProductionHygiene()
# 在 PROD 下见到 VITE_USE_MOCK=true 或非空 VITE_DEV_TOKEN 会直接抛错。

# 接口基地址。开发期保持 /api，由 vite 代理转发到本地后端。
VITE_API_BASE_URL=/api

# mock 总开关：只覆盖登录页及其配套 4 条接口，商品/抽卡/订单一律走真实后端。
#
# 【默认关闭】只有显式 true 才启用（原先是 `!== 'false'` 即默认开启，
# 漏配变量会静默跑假数据，见 OCR 审查 P2-3）。本示例给的是开发值 true。
VITE_USE_MOCK=true

# 开发期真实用户令牌（见 README「开发令牌」）。
# 留空时会话降级为 mock-only，抽卡/订单将返回 401。
# 【切勿进生产包】它会被静态内联进 JS，任何访客都能读出来直接调用需鉴权接口。
VITE_DEV_TOKEN=

# 开发期代理目标（仅 vite.config.ts 读取，不打包进产物）。
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8080
