# 开发环境本地覆盖配置示例
#
# 用法：
#   cp .env.yaml.example .env.yaml
# 然后按需修改里面的字段。
#
# 注意：
#   - 本文件位于项目根目录，与 config/*.yaml 分开存放
#   - .env.yaml 已在 .gitignore 中，不会被提交到仓库
#   - 本文件中的字段会以最高优先级覆盖 config/*.yaml 中的同名配置项
#   - 此文件本身作为模板必须保留在仓库中（文件名 .example 后缀），方便其他人复用
#
# 下方示例展示如何覆盖 config.yaml 的部分数据库连接信息，方便本地起 MySQL 时使用：

# 覆盖服务运行模式：dev / release。
# 本地开发需要看 swagger UI 时改成 dev；提交前改回 release。
# 注意：默认 release 不挂载 /swagger/*any，与生产一致。
server:
  mode: dev

database:
  # 覆盖写库连接
  write:
    host: 127.0.0.1
    port: 3306
    username: root
    # 改成你自己的本地密码；不要把真实值 commit 到仓库（.env.yaml 已在 .gitignore）
    password: <你的本地MySQL密码>
    dbname: ai_go_mall_local
    max_open_conns: 50

  # 如本地也起了从库，把 enabled 改成 true 并填写从库连接
  read:
    enabled: false
    # host: 127.0.0.1
    # port: 3307
    # username: root
    # password: <你的本地MySQL密码>
    # dbname: ai_go_mall_local
    # max_open_conns: 20

# 覆盖 Redis 配置（cache.yaml）
# 本地 Redis 一般无密码，password 留空即可。
cache:
  redis:
    # password: <你的本地Redis密码>

# 覆盖 Elasticsearch 配置（search.yaml）
# 本地 ES 一般无鉴权，username / password 留空即可。
search:
  elasticsearch:
    # username: <你的本地ES用户名>
    # password: <你的本地ES密码>