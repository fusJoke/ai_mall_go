# ===== 构建产物 =====
# 编译产生的二进制
/bin/

# Air 热重载构建产物
/tmp/
build-errors.log

# Windows 下 `go build` 默认产物（无 -o 时落到仓库根）
# 仅根目录的 *.exe；不影响依赖里的可执行文件
/*.exe

# 测试产物
*.test
*.out
coverage.html

# 依赖目录（如使用 vendor）
/vendor/
/node_modules/

# web 前端依赖
/web/node_modules/
/web/dist/

# 根目录不应直接存在前端 manifest（仅 web/ 目录允许）
/package.json
/package-lock.json

# ===== 本地配置（覆盖用，优先级最高）=====
# 个人本地开发覆盖配置，复制 .env.yaml.example 后按需修改
# 此文件必须在仓库中保留
/.env.yaml

# ===== 编辑器 / IDE =====
.idea/
.vscode/
*.swp
*.swo
*~

# ===== 操作系统 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Claude Code 本地配置 ======
# .claude/settings.local.json 是 Claude Code 在本地运行期自动写入的
# 机器特定配置（绝对路径、本地端口、auto-approval 规则、可能含密码的环境变量）。
# 该文件应当 per-machine，不进版本控制；共享规则放到 .claude/settings.json。
.claude/settings.local.json

# ===== 本地调试残留 =====
# Playwright MCP 在浏览器自动化过程中产生的中间产物
.playwright-mcp/
# 一次性调试截图，例如 e2e 失败时手动截屏
/login-error.png
# GUI 黑盒测试证据截图（本地留存，不入库）
/gui-test-screenshots/
